; shamelessly taken from this [tweet](https://x.com/gazdovsky/status/2077072611696079170) for tests

(define Z
  (lambda (f)
    (
      (lambda (x) (f (lambda (v) ((x x) v))))
      (lambda (x) (f (lambda (v) ((x x) v))))
    )))

(define factorial-generator
  (lambda (rec)
    (lambda (n)
      (if (= n 0)
        1
        (* n (rec (- n 1)))))))

(define factorial (Z factorial-generator))

(println (factorial 20))
